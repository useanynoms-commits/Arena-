APP_ENV=production
APP_URL=https://shop.example.com
APP_KEY=replace_with_a_long_random_string
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecom_minutes
DB_USER=ecom_user
DB_PASS=replace_me

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecom-minutes

# Shiprocket logistics (server-side only)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# Fastrr / Shiprocket Checkout: supplied by Shiprocket after merchant activation.
# Leave empty to use the internal session checkout and Shiprocket shipment workflow.
FASTRR_CHECKOUT_URL=
FASTRR_MERCHANT_ID=
