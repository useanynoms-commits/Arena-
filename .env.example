# Server-side only. Do not prefix these variables with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here
# Preferred compact, lower-cost model. The route automatically falls back if it is unavailable or fails.
GEMINI_MODEL=gemini-2.0-flash-lite
# Comma-separated fallback order; customize this to the models enabled for your Google AI project.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
